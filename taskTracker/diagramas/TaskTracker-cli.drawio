        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam BoxPadding 10\nskinparam ParticipantPadding 10\n\nactor \&quot;Usuario\&quot; as User\nparticipant \&quot;:Main\&quot; as Main\nparticipant \&quot;:TaskManager\&quot; as Manager\nparticipant \&quot;:TaskDAO\&quot; as DAO\ndatabase \&quot;Archivo JSON\&quot; as JSON\n\nUser -&gt; Main : task-cli add \&quot;...\&quot;\nactivate Main\n\nMain -&gt; Manager : addTask(description)\nactivate Manager\n\nalt #LightPink Escenario 1: Descripción Vacía\n    Manager -&gt; Manager : Validar descripción\\n[Falla: está vacía]\n    Manager --&gt; Main : Lanza Error (\&quot;Description cannot be empty\&quot;)\n    Main --&gt; User : Imprime error en consola\nelse #LightGreen Escenario 2: Descripción Válida\n    Manager -&gt; DAO : getAllTasks()\n    activate DAO\n    \n    DAO -&gt; JSON : fs.readFile()\n    activate JSON\n    JSON --&gt; DAO : Datos texto JSON\n    deactivate JSON\n    \n    DAO --&gt; Manager : Retorna Array de Tareas\n    deactivate DAO\n    \n    Manager -&gt; Manager : Generar nuevo ID autoincremental\\ny crear objeto Task\n    \n    Manager -&gt; DAO : saveTask(newTask)\n    activate DAO\n    \n    DAO -&gt; JSON : fs.writeFile(updatedData)\n    activate JSON\n    JSON --&gt; DAO : Confirmación de escritura\n    deactivate JSON\n    \n    DAO --&gt; Manager : Confirmación de guardado\n    deactivate DAO\n    \n    Manager --&gt; Main : Éxito (Operación completada)\n    deactivate Manager\n    \n    Main --&gt; User : Muestra \&quot;Task added successfully (ID: X)\&quot;\n    deactivate Main\nend\n\n@endum\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wQ2orCsgyPUizglmMbC7-81">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
